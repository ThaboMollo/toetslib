{
  "devCommand": "npm run dev",
  "devPort": 5173,
  "baseUrl": "http://localhost:5173",

  "externalServer": false,

  "auth": {
    "strategy": "form",
    "loginUrl": "/login",
    "fields": {
      "email": "#email",
      "password": "#password"
    },
    "submitSelector": "button[type=submit]"
  },

  "routes": [],

  "crawl": {
    "maxPages": 150,
    "followLinks": true,
    "exclude": ["/logout"]
  },

  "outputDir": "./e2e",
  "maxHealCycles": 3
}
